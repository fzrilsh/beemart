@page
@model BeeMart.WebClient.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<main class="auth-page">
    <section class="auth-card">
        <div class="auth-body">
            <h1 class="auth-title">Register Akun</h1>

            <div class="form-error @(Model.ErrorMessage is null ? "" : "is-visible")" id="formError">@Model.ErrorMessage</div>

            <form method="post" id="registerForm" novalidate>
                <div class="field">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="Username" value="@Model.Username" autocomplete="username" />
                    <div class="field-error"></div>
                </div>

                <div class="field">
                    <label for="fullName">Full Name</label>
                    <input type="text" id="fullName" name="FullName" value="@Model.FullName" autocomplete="name" />
                    <div class="field-error"></div>
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="Password" autocomplete="new-password" />
                    <div class="field-error"></div>
                </div>

                <div class="field">
                    <label for="rePassword">Re-Password</label>
                    <input type="password" id="rePassword" name="RePassword" autocomplete="new-password" />
                    <div class="field-error"></div>
                </div>

                <div class="field">
                    <label for="role">Role</label>
                    <select id="role" name="Role">
                        @if (Model.Role == "Admin")
                        {
                            <option value="Cashier">Kasir</option>
                            <option value="Admin" selected>Admin</option>
                        }
                        else
                        {
                            <option value="Cashier" selected>Kasir</option>
                            <option value="Admin">Admin</option>
                        }
                    </select>
                    <div class="field-error"></div>
                </div>

                <button type="submit" class="btn btn-block">Daftar</button>
            </form>

            <a class="auth-link" href="/Login">Sudah punya akun? Login</a>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/register.js" asp-append-version="true"></script>
}
